# Database (required)
MONGODB_URI="<your-mongodb-uri>"
DATABASE_NAME="agentic_predictive_maintenance"

# Chat completions (choose one: bedrock or grove)
CHAT_PROVIDER="bedrock"
# Model ID supported by the selected chat provider
COMPLETION_MODEL="us.anthropic.claude-haiku-4-5-20251001-v1:0"
# Required only when CHAT_PROVIDER=grove
GROVE_API_KEY="<your-grove-api-key>"

# Embeddings (choose one: bedrock or voyage)
EMBEDDING_PROVIDER="voyage"
# Model ID and output dimensions for the selected embedding provider
EMBEDDING_MODEL="voyage-4"
EMBEDDING_DIMENSIONS="1024"
# Required only when EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY="<your-voyage-api-key>"

# AWS Bedrock (required only when CHAT_PROVIDER or EMBEDDING_PROVIDER is bedrock)
AWS_REGION="us-east-1"
# Optional when credentials are supplied by the default AWS credential chain
AWS_PROFILE="default"